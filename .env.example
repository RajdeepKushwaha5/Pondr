# Copy to .env and fill in. Every integration falls back to a clearly labelled
# mock mode when its keys are missing, so the app runs out of the box.

PORT=3000
# Public URL of this server (used for PayPal return/cancel URLs).
BASE_URL=http://localhost:3000

# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the same app, enables signature verification.
PAYPAL_WEBHOOK_ID=
# Sandbox personal (buyer) account that receives goal payouts.
PAYPAL_PAYOUT_RECEIVER=
CURRENCY=EUR

# AI provider. Set ONE key; Pondr uses Groq if GROQ_API_KEY is set, else Claude.
# Force a provider with AI_PROVIDER=groq|claude|mock.
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Claude (optional): https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Channel3 product data (promo code PAYPAL-HACKATHON-2026): https://trychannel3.com/developers
CHANNEL3_API_KEY=

# Telegram companion (optional): message @BotFather, send /newbot, paste the token here.
TELEGRAM_BOT_TOKEN=
